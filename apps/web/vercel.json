{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/web/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kta-og4o7kr8k-asko.vercel.app"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
