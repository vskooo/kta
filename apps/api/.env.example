NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://catita:catita_local_password@localhost:5433/muak?schema=public
FRONTEND_URL=http://localhost:4200
RECENT_SPINS_DEFAULT_LIMIT=10
RECENT_SPINS_MAX_LIMIT=50

# Notificaciones por correo (opcional). Si faltan, las notificaciones se omiten.
# Ejemplo con Gmail: usa una "contraseña de aplicación", no tu clave normal.
# Gmail funciona mejor con el puerto 465 (SSL directo).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password
MAIL_FROM="Ruleta Catita <tu-correo@gmail.com>"
MAIL_TO=donde-quieres-recibir-los-avisos@ejemplo.com

